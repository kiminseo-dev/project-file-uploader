* {
  box-sizing: border-box;
}

body {
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  line-height: 1.6;
  color: #222;
  max-width: 700px;
  margin: 0 auto;
  padding: 24px;
}

a {
  /* Removes underline for anchor elements */
  text-decoration: none;
  color: inherit;
}

h1, h2 {
  margin-top: 0.4em;
  margin-bottom: 0.4em;
}

p {
  margin: 0.5em 0;
}

hr {
  border: none;
  border-top: 1px solid #ddd;
  margin: 24px 0;
}

nav {
  display: flex;
  gap: 16px;
  padding: 12px 16px;
  margin-bottom: 24px;
  background: #f5f5f5;
  border-radius: 10px;
}

nav a {
  font-weight: 500;
}

button {
  font-family: inherit;
  font-size: 0.95em;
  padding: 8px 16px;
  margin: 4px 4px 4px 0;
  border: 1px solid #ccc;
  border-radius: 8px;
  background: #f5f5f5;
  color: #222;
  cursor: pointer;
}

button:hover {
  background: #eaeaea;
}

input,
textarea {
  font-family: inherit;
  font-size: 1em;
  width: 100%;
  padding: 10px 12px;
  margin: 6px 0;
  border: 1px solid #ccc;
  border-radius: 8px;
  background: #fafafa;
}

form {
  display: flex;
  flex-direction: column;
  padding: 16px;
  margin: 16px 0;
  border: 1px solid #eee;
  border-radius: 12px;
}

.author {
  padding: 10px 14px;
  margin: 6px 0;
  border-radius: 8px;
  background: #f5f5f5;
}

/* post cards in postsContainer.ejs */
div:has(> h2) {
  padding: 16px;
  margin: 16px 0;
  border-radius: 12px;
  background: #fafafa;
}
