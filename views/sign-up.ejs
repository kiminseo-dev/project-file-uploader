<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sign Up</title>
  </head>
  <body>
    <form action="/sign-up" method="post">
        <label for="name">Name:</label>
        <input 
          id="name" 
          name="name" 
          type="text" 
          value="<%= locals.body ? locals.body.name : "" %>" 
          required 
        />

        <label for="username">Username:</label>
        <input 
          id="username" 
          name="username" 
          type="text" 
          value="<%= locals.body ? locals.body.username : "" %>"  
          required 
        />

        <label for="password">Password:</label>
        <input 
          id="password" 
          name="password" 
          type="password" 
          value="<%= locals.body ? locals.body.password : "" %>" 
          required 
        />

        <button type="submit">Sign Up</button>
    </form>
    <p><%= locals.body ? `${locals.body.username} is already taken` : ""%></p>
  </body>
</html>
