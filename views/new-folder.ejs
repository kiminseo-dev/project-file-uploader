<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Make a new folder</title>
  </head>
  <body>
    <form action="/folders/new" method="post">
      <label for="name">Name:</label>
      <input 
        name="name" 
        id="name" 
        type="text" 
        value="<%= locals.name ? locals.name : ''%>" 
        required 
      />
      <button type="submit">Submit</button>
    </form>
    <p><%= locals.name ? `${locals.name} folder already exists` : "" %></p>
  </body>
</html>
