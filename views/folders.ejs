<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Folders</title>
  </head>
  <body>
    <a href="/folders/new"><strong>Create New Folder</strong></a>

    <form action="/folders/upload" method="POST" enctype="multipart/form-data">
      <label for="file">Choose a file:</label>
      <input type="file" id="file" name="file" required>
      <button type="submit">Upload</button>
    </form>

    <br>
    <% folders.forEach(folder => { %>
        <fieldset>
        <a href="/folders/<%= folder.id %>"><%= folder.name %></a>
        <br>
        <a href="/folders/<%= folder.id %>/edit">Edit</a>
        <br>
        <form action="/folders/<%= folder.id %>/delete" method="post">
            <button type="submit">Delete</button>
        </form>
        </fieldset>
    <% }); %>

    <% files.forEach(file => { %>
      <fieldset>
        <legend><%= file.originalName %></legend>
        
        <form action="/folders/files/<%= file.id %>/download" method="post">
          <button type="submit">Download</button>
        </form>

        <form action="/folders/files/<%= file.id %>/delete" method="post">
          <button type="submit">Delete</button>
        </form>
      </fieldset>
    <% }); %>

  </body>
</html>
